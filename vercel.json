{
  "version": 2,
  "buildCommand": "cd frontend && npm ci && npm test && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
